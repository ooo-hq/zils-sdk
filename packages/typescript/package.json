{
  "name": "@zils/sdk",
  "version": "0.4.4",
  "description": "Typed JavaScript and TypeScript client for Zils decisions",
  "license": "MIT",
  "homepage": "https://zils.ai",
  "repository": {
    "type": "git",
    "url": "https://github.com/ooo-hq/zils-sdk.git",
    "directory": "packages/typescript"
  },
  "publishConfig": { "access": "public", "registry": "https://registry.npmjs.org/" },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": { ".": { "types": "./dist/index.d.ts", "default": "./dist/index.js" } },
  "files": ["dist", "README.md", "LICENSE"],
  "engines": { "node": ">=20" },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "npm run build && tsc -p tsconfig.test.json && node --test test/*.test.mjs",
    "prepack": "npm run build"
  },
  "dependencies": { "@typesafe-ai/sdk": "0.6.0" },
  "devDependencies": { "typescript": "~5.9.3", "@types/node": "^22.0.0" }
}
